# ─── Application ────────────────────────────────────────────────
# Public canonical URL of the deployed site. Feeds sitemap.xml,
# robots.txt, OG image meta, canonical links. Include scheme, no
# trailing slash.
NEXT_PUBLIC_SITE_URL=https://build.store

# ─── Postgres (active) ──────────────────────────────────────────
# Connection string to the Dokploy-hosted Postgres 18 instance.
# Use the INTERNAL Docker DNS hostname (external access should be
# off on the DB service for security). Drizzle client + seed script
# both read this.
DATABASE_URL=postgresql://appuser:REPLACE_ME@future-modern-database-9v4pfx:5432/app

# ─── HubSpot CRM (active) ───────────────────────────────────────
# Private App access token from HubSpot Settings → Integrations →
# Private Apps → Auth. Scopes required: crm.objects.contacts.write,
# crm.objects.deals.write, crm.schemas.contacts.read,
# crm.schemas.deals.read.
HUBSPOT_ACCESS_TOKEN=

# App client secret from developers.hubspot.com → your app → Auth.
# Used to verify inbound webhook signatures on
# /api/hooks/hubspot/stage. Route fails closed without it.
HUBSPOT_APP_CLIENT_SECRET=

# ─── Auth.js (production activation) ────────────────────────────
# Wire these when Tolgay/Billy activates Auth.js per production-
# swap-checklist §2. Sandbox uses auth-stub.ts and ignores them.

# Random 32+ char secret for signing session tokens. Generate via
# `openssl rand -base64 32`.
AUTH_SECRET=

# Auth.js canonical URL. Same as NEXT_PUBLIC_SITE_URL typically.
AUTH_URL=https://build.store

# Email magic-link provider (primary auth path)
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM="Future Modern <hello@build.store>"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# ─── Documenso (self-hosted signature layer) ─────────────────────
# FM runs Documenso self-hosted at sign.afuturemodern.com (Bayu
# deployed on Dokploy). All signature capture routes through this
# instance. Full data ownership — audit trail stays on FM infra.

# Base URL of the self-hosted Documenso instance. Default matches
# the FM production deployment; override for local dev if pointing
# at a demo instance or your own Docker container.
DOCUMENSO_BASE_URL=https://sign.afuturemodern.com

# API key issued from the Documenso admin dashboard
# (Settings → API Tokens). Format: api_xxxxxxxxxxxxxxxx.
# Server-side only — never exposed to the client.
DOCUMENSO_API_KEY=

# HMAC secret for verifying inbound webhook signatures. Set on the
# Documenso side when configuring webhook subscribers; paste the
# same value here. Webhook route fails closed without it.
DOCUMENSO_WEBHOOK_SECRET=

# Canonical template envelope IDs. Populated after uploading each
# canonical template via the Documenso admin dashboard on
# sign.afuturemodern.com. See src/lib/documenso.ts DOCUMENSO_TEMPLATES
# for how these get consumed.
DOCUMENSO_TEMPLATE_TALENT_PARTNER_LOI=
DOCUMENSO_TEMPLATE_COOPERATIVE_QUOTE=
DOCUMENSO_TEMPLATE_RETROACTIVE_RECEIPT=

# ──────────────────────────────────────────────────────────────
# Payments hub — outbound payout rails (task #63)
#
# The hub dispatches contributor payouts through whichever rail a
# contributor registers. Each rail is independent: leaving one unset
# just means it reports not_configured at /api/payments/health and
# contributors can't pick it. Nothing breaks.
#
# PayPal and Venmo are deliberately NOT supported. See
# src/lib/payments/types.ts for the reasoning.
# ──────────────────────────────────────────────────────────────

# Stripe Connect — the recommended automated rail. Same account as
# the inbound card-payment integration; Connect just adds transfers.
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=

# Plaid — bank account verification. NOTE: Plaid is not a payment
# network. With PLAID_TRANSFER_ENABLED unset (the expected config
# through beta), Plaid only verifies the account and the actual ACH
# is originated from Mercury by an admin. Set to "true" ONLY after
# Plaid approves Transfer underwriting for the cooperative.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_TRANSFER_ENABLED=

# Crypto treasury — USDC on Base. Two supported providers:
#   circle → custodial, simpler, recommended for beta
#   safe   → self-custody multisig, matches the treasury posture in
#            build-vision.md, slower to operate
TREASURY_PROVIDER=
TREASURY_API_KEY=
TREASURY_WALLET_ADDRESS=
BASE_RPC_URL=

# Zelle and check need no configuration — they are assisted rails.
# An admin sends them by hand from Mercury and confirms in
# /admin/payments. There is no Zelle disbursement API to configure.
